# Telegram
TG_BOT_TOKEN=123456:ABCDEF
TG_OWNER_ID=123456789

# Шифрование сессионных cookies (32 байта в base64).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

# SQLite
DB_PATH=./data/bot.db

# Запуск ежедневного штурма (МСК)
DAILY_RUN_HOUR=9
DAILY_RUN_MINUTE=0

# Сколько секунд держать штурм после старта
ATTACK_WINDOW_SECONDS=1800

# Интервал между попытками внутри штурма
ATTACK_RETRY_SECONDS=3

# Интервал автообновления списка складов (сек)
WAREHOUSES_REFRESH_SECONDS=300

# Логи
LOG_LEVEL=INFO
